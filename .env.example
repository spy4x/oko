# Required
DOMAIN=antonshubin.com

# Comma-separated FQDNs of every gatus instance. Endpoint keys in
# config.json are namespaced by host (e.g. "uptime-cloud|home_a")
# via gatus_host, so this list decides which gatus owns each key.
UPTIME_HOSTS=uptime-cloud.${DOMAIN},uptime-home.${DOMAIN}

# Optional
PORT=8080
UPTIME_TIMEOUT_SECS=5
CACHE_TTL_SECS=60
TEMPLATE_PATH=/app/web/template.html
CONFIG_PATH=/app/config.json
