# Required: base domain substituted into ${DOMAIN} in config.json URLs.
DOMAIN=example.com

# Required: comma-separated gatus FQDNs. The leading subdomain of each
# FQDN becomes the short name referenced by `gatus_host` in
# config.json (e.g. "uptime-cloud.example.com" → "uptime-cloud").
UPTIME_HOSTS=uptime-cloud.example.com,uptime-home.example.com

# Optional.
PORT=8080
UPTIME_TIMEOUT_SECS=5
CACHE_TTL_SECS=60
TEMPLATE_PATH=/app/web/template.html
CONFIG_PATH=/app/config.json
